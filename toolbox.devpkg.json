{
  "module": "github.com/solidarity-ai/microsoft-365-toolbox",
  "name": "microsoft-365",
  "runtime": "typescript-sandbox",
  "additionalTypeScriptGlobs": ["lib/*.ts"],
  "allowed_hosts": ["graph.microsoft.com"],
  "credentials": [
    {
      "name": "microsoft_graph",
      "type": "oauth2",
      "provider": {
        "name": "microsoft",
        "pkce": true,
        "auth_params": {
          "prompt": "select_account"
        }
      },
      "scopes": [
        "openid",
        "profile",
        "offline_access",
        "User.Read",
        "Sites.Read.All",
        "Files.Read.All",
        "Files.ReadWrite.All"
      ],
      "inject": {
        "hosts": ["graph.microsoft.com"],
        "method": "bearer_header"
      }
    }
  ],
  "tools": [
    {
      "entry_ts": "tools/me.get.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/sites.search.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/sites.get.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/site-lists.list.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/site-list-items.list.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/site-drives.list.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/drive-items.get.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/drive-items.resolve-sharing-url.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/excel-workbooks.find.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/excel-workbooks.get.ts",
      "effect": "readOnly",
      "idempotent": true
    },
    {
      "entry_ts": "tools/excel-sessions.create.ts",
      "effect": "reversible",
      "idempotent": false
    },
    {
      "entry_ts": "tools/excel-sessions.close.ts",
